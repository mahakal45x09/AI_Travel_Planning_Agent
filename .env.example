# =============================================================
# AI Travel Planning Agent - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================

# --- LLM Provider (choose one) ---
# Option 1: Google Gemini (recommended - free tier available)
GOOGLE_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# --- Default LLM Settings ---
LLM_PROVIDER=gemini
# Options: gemini, openai, ollama
LLM_MODEL=gemini-2.0-flash
# For OpenAI: gpt-4o-mini, gpt-4o
# For Ollama: llama3, mistral

# --- Database ---
DATABASE_URL=sqlite:///./travel_agent.db

# --- API Settings ---
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# --- External APIs (optional, for enhanced features) ---
# Open-Meteo Weather API (free, no key needed)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Exchange Rate API (free tier: 1500 req/month)
EXCHANGE_RATE_API_KEY=your_key_here

# --- ChromaDB (Vector Database) ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=travel_destinations

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
